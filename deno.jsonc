{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "lint": {
    "files": {
      "include": ["tools"]
    },
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "files": {
      "include": ["deno.jsonc", "tools"]
    },
    "options": {
      "lineWidth": 1000, // I hate line wrapping
      "singleQuote": true
    }
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.0.0",
    "@binary-parser": "npm:binary-parser@2.3.0",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@^1.1.4"
  }
}