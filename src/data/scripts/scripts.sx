.include "asm/macros.inc"
.include "asm/scripts/commands.inc"
.include "asm/scripts/constants.inc"
#include "constants/song.h"
#include "constants/entity.h"
#include "constants/flag.h"
#include "constants/cutscene.h"
#include "text_ids.h"

.balign 4
.section .rodata

@ idx is StageID
.global gStageScriptList
gStageScriptList: @ 0x0834d06c
  .4byte gStage0ScriptList
  .4byte gSpaceCraftScriptList
  .4byte gVolcanoScriptList
  .4byte gOceanScriptList
  .4byte gRepairFactoryScriptList
  .4byte gOldResidentialScriptList
  .4byte gMissileFactoryScriptList
  .4byte gTwilightDesertScriptList
  .4byte gAnatreForestScriptList
  .4byte gFrostlineIceBaseScriptList
  .4byte gAreaX2ScriptList
  .4byte gEnergyFacilityScriptList
  .4byte gSnowyPlainsScriptList
  .4byte gSunkenLibraryScriptList
  .4byte gGiantElevatorScriptList
  .4byte gSubArcadiaScriptList
  .4byte gWeilLaboScriptList
  .4byte gResistanceBaseScriptList

.global Script_MissionFail
Script_MissionFail: @ 0x0834d0b4
    forcekeyinput 0xFFFF
    kill_message
    stop_bgm
    wait SECOND
    message 5 0 0
    wait SECOND
    message 2 0 0
    wait_indicator_end
    failed_or_gameover_indicator
    wait_indicator_end
    fadeout_se SECOND SE_IN_SEA
    start_transition 10
    wait_transition_end
    wait SECOND
    end

.global Script_MissionFail2
Script_MissionFail2: @ 0x0834d12c
    forcekeyinput 0xFFFF
    kill_message
    stop_bgm
    wait_transition_end
    normal_screen
    wait SECOND
    message 5 0 0
    wait SECOND
    message 2 0 0
    wait_indicator_end
    failed_or_gameover_indicator
    wait_indicator_end
    fadeout_se SECOND SE_IN_SEA
    start_transition 10
    wait_transition_end
    wait SECOND
    end

.global CielGoodluckTextIDs
CielGoodluckTextIDs: @ 0x0834d1b4
    .2byte 0x0000, TEXT_SYSTEM_WHAT_SHOULD_IDO_WELL_ALIAS7, TEXT_SYSTEM_THANK_YOU_ZERO_WE_FAILED, TEXT_SYSTEM_ZERO_IMSORRY_YOU, TEXT_SYSTEM_ZERO_THANK_YOU_THAT_RECYCLING, TEXT_SYSTEM_ZERO_THANK_YOU_THE_REPORTS, 0x0000, TEXT_SYSTEM_CIEL_GOODLUCK_7
    .2byte TEXT_SYSTEM_CIEL_GOODLUCK_8, TEXT_SYSTEM_CIEL_GOODLUCK_9, TEXT_OTHERS_SO_THIS_IS_WHAT_IT, TEXT_SYSTEM_WELCOME_BACK_ZERO_IT_APPEARS, TEXT_SYSTEM_CIEL_GOODLUCK_12, TEXT_SYSTEM_CIEL_GOODLUCK_13, TEXT_SYSTEM_THANK_YOU_ZERO_IT_LOOKS, TEXT_SYSTEM_ZERO_IT_SGREAT_TO
    .2byte 0x0000, 0x0000

#include "./stage0.inc"
