#include "./repair_factory.inc"
#include "./old_residential.inc"
#include "./missile_factory.inc"
#include "./twilight_desert.inc"
#include "./anatre_forest.inc"
#include "./frostline_ice_base.inc"
#include "./area_x2.inc"
#include "./energy_facility.inc"
#include "./snowy_plains.inc"
